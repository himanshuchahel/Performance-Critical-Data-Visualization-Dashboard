# ================================================================
# DataForge — Root Environment Example (Development / Production)
# ================================================================
# NEVER commit real secrets. Copy to .env and fill with actual values.
# .env is ignored by .gitignore.

# --- Development ---
VITE_API_BASE_URL=
# --- Production ---
# NODE_ENV=production
# PORT=3001
# CLIENT_URL=https://your-domain.com
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dataforge
# JWT_SECRET=strong-random-secret-at-least-32-chars
# B2_KEY_ID=your-b2-key-id
# B2_APPLICATION_KEY=your-b2-application-key
# B2_BUCKET_ID=your-b2-bucket-id
# B2_BUCKET_NAME=your-b2-bucket-name
