# DataForge Frontend Environment Example
# ================================================================
# Vite variables are build-time only.
# For local dev: copy to .env and set VITE_API_BASE_URL.
# For Docker production: the nginx /api proxy handles this cleanly.

# Point to backend (use /api when nginx proxies, or full URL when direct)
VITE_API_BASE_URL=/api
